{
  "*.{ts,tsx}": [
    "eslint --fix",
    "prettier --write"
  ],
  "*.{json,md,yml,yaml}": [
    "prettier --write"
  ],
  "*.rs": [
    "node scripts/run-if-installed.mjs cargo fmt --"
  ],
  "*.py": [
    "node scripts/run-if-installed.mjs ruff check --fix",
    "node scripts/run-if-installed.mjs ruff format"
  ]
}
