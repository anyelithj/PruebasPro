# .env.example (infra/docker) => SOLO variables de la infraestructura compartida que interpola docker-compose.dev.yml.
# Vive junto al compose porque Docker Compose lee ".env" desde la carpeta del archivo compose, no desde la raíz del repo.
# Las variables de cada app viven en apps/<app>/.env.example (SRP de config: cada servicio es dueño de sus secretos,
# y se despliega por separado). Copiar: cp infra/docker/.env.example infra/docker/.env  |  cp apps/<app>/.env.example apps/<app>/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db

# Puerto del gateway Nginx en el host (punto de entrada único: tienda, secciones Nuxt y APIs)
GATEWAY_PORT=8088

# --- Solo PRODUCCIÓN (docker-compose.prod.yml) ---
# MongoDB con autenticación (en desarrollo no la usa). MONGO_URL de Express: mongodb://USUARIO:CLAVE@mongodb:27017/ecommerce?authSource=admin
MONGO_USER=
MONGO_PASSWORD=
# Dueño de las imágenes en ghcr.io (tu usuario de GitHub en minúsculas) y etiqueta a desplegar (latest o el SHA de un commit)
GHCR_OWNER=
IMAGE_TAG=latest
# Solo si construyes la imagen de Next.js EN el servidor (con la CD se definen como variables del repositorio en GitHub)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
