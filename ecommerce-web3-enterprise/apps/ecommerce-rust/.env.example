# .env.example (ecommerce-rust) => plantilla versionada; copiar a .env (nunca se sube a git)
# Hosts para correr con "pnpm dev" en tu equipo (localhost). En Docker, docker-compose.dev.yml los reemplaza por los nombres de servicio.
# Comentarios en líneas propias: dotenvy no garantiza soporte de comentarios al final de la línea

# Puerto HTTP de Axum
PORT=8080
# Nivel de logs de tracing-subscriber
RUST_LOG=info,tower_http=debug
# SeaORM -> PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ecommerce_db
# Cache distribuida / pub-sub
REDIS_URL=redis://localhost:6379
# Mismo secreto que Express para validar los JWT emitidos por Auth
JWT_ACCESS_SECRET=change-me-access-secret
# Nodo RPC EVM usado por ethers
ETH_RPC_URL=https://sepolia.infura.io/v3/change-me
# reqwest -> otros microservicios
EXPRESS_API_URL=http://localhost:4000
FASTAPI_URL=http://localhost:8000
