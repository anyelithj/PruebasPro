# .env.example (ecommerce-express) => plantilla versionada; copiar a .env (nunca se sube a git)
# Hosts para correr con "pnpm dev" en tu equipo (localhost). En Docker, docker-compose.dev.yml los reemplaza por los nombres de servicio.
# Validado al arrancar por src/config/app.config.ts (Zod): si falta algo obligatorio el proceso no inicia.

PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Persistencia ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce_db
MONGO_URL=mongodb://localhost:27018/ecommerce_docs
REDIS_URL=redis://localhost:6379

# --- JWT (mínimo 16 caracteres; en producción, secretos aleatorios de 64+) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Correo (Mailpit/MailHog en desarrollo: SMTP 1025, UI en 8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eCommerce Web3 <no-reply@ecommerce-web3.dev>"

# --- Comercio ---
DEFAULT_CURRENCY=COP
TAX_RATE=0.19
CHECKOUT_TTL_MINUTES=30
CART_TTL_DAYS=30
LOYALTY_POINTS_PER_UNIT=100000

# --- Stripe (claves de prueba sk_test_ / whsec_ del dashboard o de "stripe listen") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) ---
CLOUDINARY_URL=

# --- Revalidación ISR bajo demanda del storefront (Next.js /api/revalidate); vacío = solo expiración por tiempo ---
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Mismo valor que REVALIDATE_SECRET en apps/ecommerce-next/.env (mínimo 16 caracteres)
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Motor IA (FastAPI) para búsqueda por imagen ---
FASTAPI_URL=http://localhost:8000

# --- Facturación electrónica DIAN (ambiente 2 = habilitación/pruebas) ---
DIAN_INVOICE_PREFIX=SETP
DIAN_TECHNICAL_KEY=fc8eac422eba16e22ffd8c6f94b3f40a6e38162c
DIAN_SELLER_NIT=900000000
DIAN_ENVIRONMENT=2

# --- Web3: NFT badges de fidelidad (ERC-721 con safeMint) + IPFS ---
WEB3_RPC_URL=
WEB3_PRIVATE_KEY=
NFT_CONTRACT_ADDRESS=
# Fase 9 (Blockchain en Express): cadena por defecto y RPC propios opcionales (sin valor => RPC públicos gratuitos)
WEB3_DEFAULT_CHAIN=sepolia
WEB3_RPC_URLS=
IPFS_API_URL=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# --- Push (Firebase Cloud Messaging HTTP v1, cuenta de servicio) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Web Push de la PWA (Nuxt). La pública también va en NUXT_PUBLIC_VAPID_PUBLIC_KEY; la privada solo aquí
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ecommerce.local

# --- Seed ---
SEED_ADMIN_EMAIL=admin@ecommerce.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_VENDOR_EMAIL=vendedor@ecommerce.local
SEED_VENDOR_PASSWORD=Vendedor12345!
SEED_CUSTOMER_EMAIL=cliente@ecommerce.local
SEED_CUSTOMER_PASSWORD=Cliente12345!

# --- Azure (OPCIONAL — apagado por defecto) ---
# Con AZURE_ENABLED=false (o vacío) el proyecto usa SOLO alternativas gratuitas:
#   secretos -> este .env · correo -> SMTP/Mailpit · monitoreo -> logs de winston
# Con AZURE_ENABLED=true se usa cada servicio de Azure que tenga credenciales; si alguno falla, se vuelve al gratuito.
AZURE_ENABLED=false
# Key Vault: los secretos "JWT-ACCESS-SECRET" se cargan como JWT_ACCESS_SECRET (Managed Identity o "az login")
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=

# --- Fase 6: IA local (LangChain + Ollama) — mismo modelo pequeño que FastAPI: Ollama guarda una sola copia en RAM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Tiempo que Ollama conserva el modelo cargado tras la última petición (corto = libera RAM y energía)
OLLAMA_KEEP_ALIVE=2m
LLM_MAX_TOKENS=256

# --- Fase 6: Social Commerce (vacío = solo el feed propio de la tienda; la red responde 503 si se pide) ---
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
TIKTOK_ACCESS_TOKEN=

# --- Fase 6: n8n (API opcional para crear/activar flujos; los webhooks se llaman siempre bajo N8N_WEBHOOK_URL) ---
N8N_API_URL=
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --- Fase 7: Analytics, Admin & Integrations ---
# Días que se conservan los logs de auditoría (índice TTL de MongoDB: se borran solos al vencer)
AUDIT_RETENTION_DAYS=365
# Stock disponible (stock - reservado) desde el que una variante cuenta como "stock bajo"
LOW_STOCK_THRESHOLD=5
# SuiteCRM 8 (opcional, open source): vacío = el CRM trabaja solo con la base propia, sin sincronizar contactos
SUITECRM_URL=
SUITECRM_CLIENT_ID=
SUITECRM_CLIENT_SECRET=

# --- RF 01-02: Auth y cuenta (opcionales) ---
# SMS de verificación de teléfono (Twilio). Vacío => el código se escribe en el log del servidor (desarrollo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# OAuth: secreto de la app de Facebook (appsecret_proof) y Services ID de Sign in with Apple (aud del id_token)
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
