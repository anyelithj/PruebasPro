{
  // "extends" => hereda TODAS las reglas strict + CommonJS del preset compartido @ecommerce/tsconfig (DRY monorepo)
  // Se resuelve por NOMBRE de paquete (workspace:*), no por ruta relativa "../../": la app no depende de dónde está packages/
  "extends": "@ecommerce/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    // "paths" (solo tipos) => la resolución clásica "Node" de CommonJS no lee el campo "exports" de paquetes modernos;
    // en runtime Node sí lo resuelve. Se apunta a la declaración CommonJS (.d.cts) del subpath usado
    "paths": { "graphql-ws/use/ws": ["./node_modules/graphql-ws/dist/use/ws.d.cts"] },
    "types": ["node", "jest"]
  },
  // Proyecto completo para typecheck y ESLint type-aware: código, tests, seed de Prisma y config de Jest
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts", "jest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
