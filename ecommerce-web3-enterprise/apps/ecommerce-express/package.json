    "@azure/monitor-opentelemetry": "^1.20.0",
    "@graphql-tools/schema": "^10.1.3",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/ollama": "^1.3.0",
    "@prisma/client": "5.22.0",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
