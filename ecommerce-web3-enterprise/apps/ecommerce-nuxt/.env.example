# .env.example (ecommerce-nuxt) => plantilla versionada; copiar a .env (nunca se sube a git)
# Nuxt mapea automáticamente NUXT_* a runtimeConfig y NUXT_PUBLIC_* a runtimeConfig.public (convención de Nuxt)

# URL pública del backend Express (usada en el navegador)
NUXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL pública del sitio (SEO: canonical, sitemap, Open Graph)
NUXT_PUBLIC_SITE_URL=http://localhost:3001
# URL del backend vista desde el servidor Nitro (en Docker la reemplaza docker-compose.dev.yml por la red interna)
NUXT_API_INTERNAL_URL=http://localhost:4000/api/v1
# Secreto para validar webhooks entrantes en server/api/webhooks
NUXT_WEBHOOK_SECRET=change-me-webhook-secret
# Tienda Next.js (enlaces a fichas de producto desde lookbooks, colecciones y social)
NUXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# Llave PÚBLICA VAPID para Web Push (generar el par con: npx web-push generate-vapid-keys; la privada va en Express)
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
