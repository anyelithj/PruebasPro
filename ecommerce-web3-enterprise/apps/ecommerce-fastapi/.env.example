# .env.example (ecommerce-fastapi) => plantilla versionada; copiar a .env (nunca se sube a git)
# Hosts para correr con "pnpm dev" en tu equipo (localhost). En Docker, docker-compose.dev.yml los reemplaza por los nombres de servicio.

# Entorno de ejecución: development | production | test
APP_ENV=development
# SQLAlchemy async (driver asyncpg) -> PostgreSQL con pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ecommerce_db
# Celery broker/backend + cache de predicciones
REDIS_URL=redis://localhost:6379/1
# MLflow tracking server (vacío = registro local en ./mlruns)
MLFLOW_TRACKING_URI=
# Ollama local (LLM sin costo recurrente); en Docker se usa host.docker.internal (docker-compose.dev.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=granite-embedding:278m
# Tiempo que Ollama mantiene el modelo en RAM tras la última respuesta (corto = libera memoria si nadie usa el chat)
OLLAMA_KEEP_ALIVE=2m
# Orígenes del navegador permitidos (lista JSON): Next.js en desarrollo
CORS_ORIGINS=["http://localhost:3000"]
# Mismo secreto que Express para validar los JWT emitidos por Auth
JWT_ACCESS_SECRET=change-me-access-secret
# Backend Node para tool use del asistente LLM
EXPRESS_API_URL=http://localhost:4000
# --- Fase 5B · LLM Assistant ---
# Modelo potente para preguntas largas/de comparación (vacío = solo el económico OLLAMA_MODEL; no carga un 2.º modelo)
OLLAMA_STRONG_MODEL=
# Mensajes por usuario y minuto; caché Redis de respuestas idénticas (0 = sin caché); tool use contra Express
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_CACHE_TTL_SECONDS=3600
LLM_TOOLS_ENABLED=true
