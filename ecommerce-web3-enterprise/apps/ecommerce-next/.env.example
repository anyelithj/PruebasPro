# --- API backend (Express) ---
# URL pública usada por el navegador (detrás del gateway Nginx: http://localhost:8088/api/v1).
# GraphQL y sus Subscriptions (WebSocket) se derivan de ella: <origen>/graphql y ws(s)://<origen>/graphql
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL interna usada por Server Components / NextAuth (en Docker: http://ecommerce-express:4000/api/v1); si falta usa la pública
INTERNAL_API_URL=
# Motor IA FastAPI (chat del asistente). Opcional: si falta se deriva de NEXT_PUBLIC_API_URL (:4000 => http://localhost:8000/api/v1/ml; gateway => <origen>/ai/api/v1/ml)
NEXT_PUBLIC_ML_API_URL=

# --- Sitio (SEO: canonical, JSON-LD, returnUrl de Stripe) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Microfrontend Nuxt (contenido y panel de contenido). Con el gateway Nginx usar /cms (mismo origen)
NEXT_PUBLIC_CMS_URL=http://localhost:3001/cms

# --- Pagos (clave PUBLICABLE de Stripe; la secreta vive solo en el backend) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change-me

# --- NextAuth (Auth.js v5) ---
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-nextauth-secret

# --- OAuth2 (el backend verifica el access_token de cada proveedor) ---
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
# RF-01.2 Facebook y Apple (Sign in with Apple: APPLE_CLIENT_SECRET = JWT firmado con la llave .p8, vence cada 6 meses)
FACEBOOK_CLIENT_ID=change-me
FACEBOOK_CLIENT_SECRET=change-me
APPLE_CLIENT_ID=change-me
APPLE_CLIENT_SECRET=change-me
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
DISCORD_CLIENT_ID=change-me
DISCORD_CLIENT_SECRET=change-me

# --- ISR bajo demanda: secreto compartido con Express (POST /api/revalidate). Mínimo 16 caracteres ---
REVALIDATE_SECRET=change-me-revalidate-secret

# --- SEO: "true" SOLO en producción; en otros entornos robots.txt bloquea el rastreo ---
ALLOW_INDEXING=false
