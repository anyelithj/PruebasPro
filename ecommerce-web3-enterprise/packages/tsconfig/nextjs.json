{
  "$schema": "https://json.schemastore.org/tsconfig",
  // nextjs.json (TypeScript) => preset para Next.js 15 (App Router); hereda el modo strict de base.json
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"], // Tipos del navegador (window, document) además de ES2022
    "module": "ESNext", // Next.js usa ESM nativo + bundler propio (Turbopack/webpack), no CommonJS
    "moduleResolution": "Bundler", // Resolución estilo bundler: permite imports sin extensión y "exports" de paquetes
    "jsx": "preserve", // Next.js transforma el JSX internamente; TS solo lo valida, no lo compila
    "noEmit": true, // Next.js genera su propio output; tsc aquí SOLO se usa para type-checking
    "declaration": false, // Una app no publica .d.ts (anula el valor de base.json pensado para packages/*)
    "declarationMap": false,
    "incremental": true, // Guarda .tsbuildinfo para acelerar typechecks sucesivos
    "allowJs": true, // Permite archivos .js (ej. postcss.config.js) dentro del proyecto
    "plugins": [{ "name": "next" }] // Plugin del language service de Next (valida "use client", rutas, etc. en el IDE)
  }
}
