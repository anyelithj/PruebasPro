# Copia este archivo como .env y completa los valores desde
# Firebase Console > Configuración del proyecto > Tus apps > SDK de la app web
VITE_APP_NAME=Gestión de Procesos
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Dónde guardar archivos adjuntos: «firestore» (gratis, máx. ~600 KB por archivo) o «storage» (Cloud Storage de Firebase)
VITE_FILES_BACKEND=firestore
