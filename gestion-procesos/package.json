{
  "name": "gestion-procesos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-env.mjs && vite",
    "start": "node scripts/check-env.mjs && vite",
    "dev:e2e": "vite --mode e2e --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test dev:e2e http://localhost:5173 cypress:run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:check": "node scripts/firebase-setup.mjs --dry-run",
    "db:setup": "node scripts/firebase-setup.mjs",
    "db:deploy": "pnpm dlx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@reduxjs/toolkit": "^2.13.0",
    "bootstrap": "^5.3.8",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "formik": "^2.4.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lodash": "^4.18.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "sweetalert2": "^11.26.25",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
