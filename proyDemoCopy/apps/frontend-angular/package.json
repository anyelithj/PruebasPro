    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@stripe/stripe-js": "^10.1.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
