# ===== Server =====
ENV=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:123456789@127.0.0.1:5432/academy

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Backend NestJS =====
BACKEND_URL=http://localhost:4000
BACKEND_API_PREFIX=/api/v1

# ===== JWT (mismo secret access que NestJS) =====
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ALGORITHM=HS256

# ===== Ollama (LLM local) =====
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=aya-expanse:8b

# ===== CORS =====
CORS_ORIGINS=http://localhost:7000,http://localhost:4000

# ===== Model paths =====
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=es_core_news_md
FAISS_INDEX_PATH=./data/faiss_index
