# ===== Server =====
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ===== Database (PostgreSQL) =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=languageproject
# Desarrollo: SYNCHRONIZE=true (TypeORM crea las tablas desde las entidades).
# Producción / base nueva: SYNCHRONIZE=false y MIGRATIONS_RUN=true → aplica src/database/migrations al arrancar.
# CLI: pnpm migration:run | migration:revert | migration:show | migration:generate src/database/migrations/<Nombre>
DATABASE_SYNCHRONIZE=true
DATABASE_MIGRATIONS_RUN=false
DATABASE_LOGGING=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=60

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# ===== Bcrypt =====
BCRYPT_SALT_ROUNDS=12

# ===== OAuth (id_token verification — mismo CLIENT_ID que el frontend) =====
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# ===== Password reset =====
# URL pública del frontend usada para construir el link de reset enviado por email
FRONTEND_URL=http://localhost:7000
# SMTP para enviar el correo de recuperación (sin SMTP_HOST el enlace solo se imprime en el log del backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NeuroLearning <no-reply@neurolearning.local>"

# ===== CORS =====
CORS_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# ===== Throttler =====
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===== FastAPI (AI Service) =====
AI_SERVICE_URL=http://localhost:8000

# ===== IA local (Ollama) =====
OLLAMA_BASE_URL=http://localhost:11434
# Modelo principal (multilingüe). Aya Expanse: licencia CC-BY-NC 4.0 → solo uso no comercial.
OLLAMA_AYA_MODEL=aya-expanse:8b
OLLAMA_QWEN_MODEL=qwen3:8b
# Tiempo que el modelo permanece en RAM tras la última petición (carga bajo demanda + liberación automática; corto = menos RAM ocupada)
OLLAMA_KEEP_ALIVE=2m
# Tope de ventana de contexto: OllamaClient la dimensiona al prompt (2048…este valor). 4096 cabe en 8 GB; súbelo a 8192 con más RAM
OLLAMA_NUM_CTX=4096
# Respaldo si el modelo del motor no cabe en RAM (solo se usan los instalados: ollama pull qwen2.5:1.5b)
OLLAMA_FALLBACK_MODELS=qwen2.5:1.5b,qwen2.5:0.5b
# false = nunca cargar un segundo modelo como respaldo (recomendado con 8 GB de RAM)
AI_FALLBACK_ENABLED=false

# ===== Almacenamiento de archivos (Sprint 6.7): materiales, audio y reportes =====
# local = disco (UPLOADS_DIR) · s3 = MinIO en desarrollo o Cloudflare R2 en producción (mismo código, solo cambian estas variables)
STORAGE_PROVIDER=local
UPLOADS_DIR=uploads
# Tamaño máximo por archivo subido (MB)
MAX_UPLOAD_MB=500
# Vida de las URL firmadas en segundos (60–604800; R2 admite hasta 7 días)
S3_SIGNED_URL_TTL=900
# --- Solo con STORAGE_PROVIDER=s3 (sin valores reales en este archivo) ---
# MinIO local: http://localhost:9900 · R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9900
# Host que ve el navegador en las URL firmadas (solo si difiere de S3_ENDPOINT, p. ej. backend dentro de Docker)
S3_PUBLIC_ENDPOINT=
# MinIO: us-east-1 · R2: auto
S3_REGION=us-east-1
S3_BUCKET=aula-idiomas
# MinIO: usuario/contraseña de la consola · R2: token de API con permiso «Object Read & Write» limitado al bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para MinIO · false para R2
S3_FORCE_PATH_STYLE=true

# ===== Pagos · Sprint 7.3 (Stripe, SOLO modo prueba) =====
# Sin STRIPE_SECRET_KEY los pagos quedan desactivados y sigue la compra de demostración.
# Recomendado: clave restringida (rk_test_…) con permisos de Checkout Sessions y Refunds · crea un sandbox con `stripe sandbox create`
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:4000/api/v1/payments/webhook` imprime el whsec_…
STRIPE_WEBHOOK_SECRET=
# Clave pública pk_test_… (viaja al navegador junto con la sesión de pago)
STRIPE_PUBLISHABLE_KEY=
# Pantalla de confirmación (Angular); {ORDER_ID} y {PAYMENT_ID} los sustituye el backend · vacío = FRONTEND_URL/checkout/confirmacion/{ORDER_ID}?pago={PAYMENT_ID}
PAYMENTS_RETURN_URL=

# ===== Web3 · Sprints 7.5/7.6 (SOLO Sepolia, testnet sin valor real) =====
# Sin WEB3_RPC_URL el pago con criptomonedas queda desactivado (503).
# RPC de Sepolia (Alchemy, Infura o público) · ETH de prueba en un faucet de Sepolia
WEB3_RPC_URL=
# Cuenta de la plataforma: recibe los pagos y firma los anclajes de certificados (NUNCA uses una clave con fondos reales)
WEB3_PLATFORM_PRIVATE_KEY=
# Opcional: dirección que recibe los pagos si no quieres poner la clave (sin clave no hay anclaje)
WEB3_PLATFORM_ADDRESS=
WEB3_MIN_CONFIRMATIONS=2
# Tasa fija de demostración: wei por centavo de USD (1e12 → 19,99 USD = 0,001999 ETH)
WEB3_DEMO_WEI_PER_CENT=1000000000000
WEB3_PAYMENT_TTL_MIN=30

# [Centro de ayuda · Sprint 7.10]: carpeta del manual de usuario (Markdown + faq.json) · vacío = ../../docs/manual-usuario (monorepo)
# HELP_MANUAL_DIR=
