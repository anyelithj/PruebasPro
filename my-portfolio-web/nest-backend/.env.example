# [CC-C] documenta vars sin exponer secretos

# App
APP_NAME="Portfolio API (Nest)"
NODE_ENV=development
APP_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (Prisma / Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_nest?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too-different-secret
JWT_REFRESH_TTL=7d

# Reseteo de contraseña (sin servicio de correo: el enlace se imprime en los logs)
FRONTEND_URL=http://localhost:3001
PASSWORD_RESET_TTL_MINUTES=30

# gRPC (servidor propio + cliente hacia el agente blockchain de FastAPI)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
# URL del gRPC de FastAPI que expone el agente blockchain.
BLOCKCHAIN_GRPC_URL=localhost:50051

# ── IA open source (Ollama — sin API keys de terceros) ──────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
AI_TEMPERATURE=0.7
# RAG se delega a FastAPI (LlamaIndex).
FASTAPI_BASE_URL=http://localhost:8000

# ── Notificaciones (canales + webhooks) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WEBHOOK_HMAC_SECRET=change-me

# Destinatario del aviso al recibir un contacto.
CONTACT_NOTIFY_EMAIL=owner@portfolio.dev

# [n8n] Webhook SALIENTE: al recibir un contacto, el backend hace POST del evento
# 'contact.created' a esta URL para disparar flujos en n8n. Vacío = desactivado.
# Ej: http://localhost:5678/webhook/portfolio-contact
N8N_WEBHOOK_URL=

# Microservicio ML (FastAPI) que clasifica los contactos.
ML_SERVICE_URL=http://localhost:8000/api/v1
