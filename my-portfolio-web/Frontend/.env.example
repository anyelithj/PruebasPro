# [CC-C] documenta vars sin exponer secretos

# Backend a consumir por defecto: 'nest' | 'fastapi'
NUXT_PUBLIC_API_PROVIDER=nest

# Base URLs públicas (cliente) — deben ser alcanzables desde el navegador
NUXT_PUBLIC_NEST_BASE_URL=http://localhost:3000/api/v1
NUXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000/api/v1

# Base URLs privadas (Nitro BFF / SSR) — pueden ser hosts internos de Docker
NEST_BASE_URL=http://localhost:3000/api/v1
FASTAPI_BASE_URL=http://localhost:8000/api/v1

# Cloudinary — subida de imágenes (blog + proyectos) directa desde el navegador.
# 1) Crea cuenta gratis en cloudinary.com  2) Settings > Upload > Add upload preset
#    con "Signing Mode: Unsigned"  3) copia aquí el cloud name y el nombre del preset.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# CV para el botón "Descargar CV". Default: /cv.pdf (pon tu PDF en Frontend/public/cv.pdf).
# O una URL externa (Cloudinary raw, Drive público, etc.).
NUXT_PUBLIC_CV_URL=/cv.pdf
