# [CC-C] documenta vars sin exponer secretos

# App
APP_NAME="Portfolio API"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Reseteo de contraseña (sin servicio de correo: el enlace se imprime en los logs)
FRONTEND_URL=http://localhost:3001
PASSWORD_RESET_TTL_MINUTES=30

# gRPC (servidor hacia NestJS — requiere `make proto` para generar stubs)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Rate limit
RATE_LIMIT_PER_MINUTE=120
BLOCKCHAIN_RATE_LIMIT_PER_MINUTE=10

# ── IA open source (Ollama — sin API keys de terceros) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_TEMPERATURE=0.7
BLOCKCHAIN_AI_MODEL=qwen2.5:7b

# ── Notificaciones (canales + webhooks) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WEBHOOK_HMAC_SECRET=change-me

# ── Solana (Opción A) — Devnet ──────────────────────────────────────────
ENABLE_SOLANA_AGENT=true
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# NO versionar la clave real — solo wallet de prueba con fondos mínimos.
SOLANA_AGENT_PRIVATE_KEY=

# ── Ethereum (Opción B) — Sepolia ───────────────────────────────────────
ENABLE_ETHEREUM_AGENT=true
ETH_RPC_URL=https://sepolia.infura.io/v3/your_project_id
ETH_NETWORK=sepolia
# NO versionar la clave real — solo wallet de prueba con fondos mínimos.
ETH_AGENT_PRIVATE_KEY=
